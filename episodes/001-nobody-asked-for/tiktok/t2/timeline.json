 "subs": [
  {
   "t0": 0.35,
   "t1": 0.918,
   "txt": "This is a"
  },
  {
   "t0": 0.918,
   "t1": 1.865,
   "txt": "real invention."
  },
  {
   "t0": 2.265,
   "t1": 2.99,
   "txt": "A wall."
  },
  {
   "t0": 3.39,
   "t1": 3.958,
   "txt": "And a man"
  },
  {
   "t0": 3.958,
   "t1": 4.716,
   "txt": "with a spray"
  },
  {
   "t0": 4.716,
   "t1": 4.969,
   "txt": "can."
  },
  {
   "t0": 5.52,
   "t1": 6.9,
   "txt": "The patent describes"
  },
  {
   "t0": 6.9,
   "t1": 7.59,
   "txt": "him as one"
  },
  {
   "t0": 7.59,
   "t1": 8.073,
   "txt": "of the,"
  },
  {
   "t0": 8.073,
   "t1": 8.488,
   "txt": "quote,"
  },
  {
   "t0": 8.488,
   "t1": 9.937,
   "txt": "decadent or otherwise"
  },
  {
   "t0": 9.937,
   "t1": 11.386,
   "txt": "indecent individuals."
  },
  {
   "t0": 11.737,
   "t1": 12.858,
   "txt": "Because graffiti,"
  },
  {
   "t0": 12.858,
   "t1": 13.386,
   "txt": "it says,"
  },
  {
   "t0": 13.386,
   "t1": 14.375,
   "txt": "is generally an"
  },
  {
   "t0": 14.375,
   "t1": 15.298,
   "txt": "assault on the"
  },
  {
   "t0": 15.298,
   "t1": 16.551,
   "txt": "visual pleasures of"
  },
  {
   "t0": 16.551,
   "t1": 16.815,
   "txt": "man."
  },
  {
   "t0": 17.266,
   "t1": 18.431,
   "txt": "And it identifies"
  },
  {
   "t0": 18.431,
   "t1": 19.186,
   "txt": "the weapon."
  },
  {
   "t0": 19.466,
   "t1": 20.569,
   "txt": "Spray paint cans,"
  },
  {
   "t0": 20.569,
   "t1": 21.088,
   "txt": "it says,"
  },
  {
   "t0": 21.088,
   "t1": 21.931,
   "txt": "are the tools"
  },
  {
   "t0": 21.931,
   "t1": 22.58,
   "txt": "of choice."
  },
  {
   "t0": 22.931,
   "t1": 23.812,
   "txt": "The solution:"
  },
  {
   "t0": 23.812,
   "t1": 24.897,
   "txt": "sensors near the"
  },
  {
   "t0": 24.897,
   "t1": 25.235,
   "txt": "wall."
  },
  {
   "t0": 25.515,
   "t1": 26.881,
   "txt": "When someone approaches,"
  },
  {
   "t0": 26.881,
   "t1": 27.905,
   "txt": "the system reacts."
  },
  {
   "t0": 28.256,
   "t1": 29.13,
   "txt": "It's called the"
  },
  {
   "t0": 29.13,
   "t1": 30.88,
   "txt": "graffiti prevention apparatus."
  },
  {
   "t0": 31.3,
   "t1": 32.132,
   "txt": "Approved."
  },
  {
