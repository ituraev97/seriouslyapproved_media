   "t1": 43.132,
   "txt": "sends the paint"
  },
  {
   "t0": 43.132,
   "t1": 43.44,
   "txt": "back."
  },
  {
   "t0": 43.791,
   "t1": 45.145,
   "txt": "The patent describes"
  },
  {
   "t0": 45.145,
   "t1": 46.229,
   "txt": "the repulsion of"
  },
  {
   "t0": 46.229,
   "t1": 47.178,
   "txt": "the fluid back"
  },
  {
   "t0": 47.178,
   "t1": 48.803,
   "txt": "from the electromagnetic"
  },
  {
   "t0": 48.803,
   "t1": 49.752,
   "txt": "field onto the"
  },
  {
   "t0": 49.752,
   "t1": 50.361,
   "txt": "intruder."
  },
  {
   "t0": 50.812,
   "t1": 51.886,
   "txt": "Thus marking him"
  },
  {
   "t0": 51.886,
   "t1": 53.564,
   "txt": "for later identification."
  },
  {
   "t0": 54.065,
   "t1": 54.799,
   "txt": "There is one"
  },
  {
   "t0": 54.799,
   "t1": 55.9,
   "txt": "small requirement."
  },
  {
   "t0": 56.4,
   "t1": 57.493,
   "txt": "For the magnetic"
  },
  {
   "t0": 57.493,
   "t1": 58.586,
   "txt": "version to work,"
  },
  {
   "t0": 58.586,
   "t1": 59.474,
   "txt": "the paint has"
