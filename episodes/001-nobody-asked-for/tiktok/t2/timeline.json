   "t1": 34.489,
   "txt": "after the can"
  },
  {
   "t0": 34.489,
   "t1": 34.937,
   "txt": "itself."
  },
  {
   "t0": 35.217,
   "t1": 35.812,
   "txt": "A valve in"
  },
  {
   "t0": 35.812,
   "t1": 36.586,
   "txt": "the spray can"
  },
  {
   "t0": 36.586,
   "t1": 37.479,
   "txt": "stops the paint"
  },
  {
   "t0": 37.479,
   "t1": 38.491,
   "txt": "when the intruder"
  },
  {
   "t0": 38.491,
   "t1": 39.206,
   "txt": "is detected."
  },
  {
