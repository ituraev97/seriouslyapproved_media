   "txt": "The only twisting"
  },
  {
   "t0": 20.878,
   "t1": 21.854,
   "txt": "motion is done"
  },
  {
   "t0": 21.854,
   "t1": 22.692,
   "txt": "by the wrist"
  },
  {
   "t0": 22.692,
   "t1": 23.459,
   "txt": "and hand of"
  },
  {
   "t0": 23.459,
   "t1": 24.087,
   "txt": "the user."
  },
  {
   "t0": 24.538,
   "t1": 25.247,
   "txt": "And if the"
  },
  {
   "t0": 25.247,
   "t1": 26.312,
   "txt": "pasta slips off"
  },
  {
   "t0": 26.312,
   "t1": 27.021,
   "txt": "on the way"
