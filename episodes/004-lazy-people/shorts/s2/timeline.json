   "txt": "approved."
  },
  {
   "t0": 16.269,
   "t1": 17.391,
   "txt": "The patent explains"
  },
  {
   "t0": 17.391,
   "t1": 18.337,
   "txt": "the problem with"
  },
  {
   "t0": 18.337,
   "t1": 19.341,
   "txt": "an ordinary fork."
  },
  {
