 "subs": [
  {
   "t0": 0.35,
   "t1": 0.978,
   "txt": "This is a"
  },
  {
   "t0": 0.978,
   "t1": 2.304,
   "txt": "real invention from"
  },
  {
   "t0": 2.304,
   "t1": 3.699,
   "txt": "nineteen fifty-nine."
  },
  {
   "t0": 4.099,
   "t1": 4.758,
   "txt": "A bed that"
  },
  {
   "t0": 4.758,
   "t1": 5.614,
   "txt": "makes itself."
  },
  {
   "t0": 6.165,
   "t1": 7.319,
   "txt": "Under the mattress,"
  },
  {
   "t0": 7.319,
   "t1": 8.109,
   "txt": "cords run out"
  },
  {
   "t0": 8.109,
   "t1": 9.02,
   "txt": "from the center"
  },
  {
   "t0": 9.02,
   "t1": 9.749,
   "txt": "like spokes."
  },
  {
   "t0": 10.029,
   "t1": 10.863,
   "txt": "Clamps hold the"
  },
  {
   "t0": 10.863,
   "t1": 11.53,
   "txt": "edges of the"
  },
  {
   "t0": 11.53,
   "t1": 11.864,
   "txt": "sheet."
  },
  {
