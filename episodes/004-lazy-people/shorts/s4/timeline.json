  {
   "t0": 24.603,
   "t1": 25.395,
   "txt": "the work is"
  },
  {
   "t0": 25.395,
   "t1": 25.971,
   "txt": "routine,"
  },
  {
   "t0": 25.971,
   "t1": 26.834,
   "txt": "and does not"
  },
  {
   "t0": 26.834,
