  },
  {
   "t0": 51.532,
   "t1": 52.873,
   "txt": "declares a long-standing"
  },
  {
   "t0": 52.873,
   "t1": 53.152,
   "txt": "need."
  },
  {
   "t0": 53.432,
   "t1": 54.568,
