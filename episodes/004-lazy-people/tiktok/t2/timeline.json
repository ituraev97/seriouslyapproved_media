  },
  {
   "t0": 15.192,
   "t1": 15.768,
   "txt": "approved."
  },
  {
   "t0": 16.269,
   "t1": 17.442,
   "txt": "The patent describes"
  },
  {
   "t0": 17.442,
   "t1": 18.146,
   "txt": "the old way."
  },
  {
   "t0": 18.426,
   "t1": 19.418,
   "txt": "The user's hand"
  },
  {
   "t0": 19.418,
   "t1": 20.278,
   "txt": "is turned and"
  },
  {
   "t0": 20.278,
   "t1": 21.402,
   "txt": "twisted to gather"
  },
  {
   "t0": 21.402,
   "t1": 22.593,
   "txt": "spaghetti onto the"
  },
  {
   "t0": 22.593,
   "t1": 23.386,
   "txt": "tines of the"
  },
  {
   "t0": 23.386,
   "t1": 23.717,
   "txt": "fork."
  },
  {
   "t0": 24.068,
   "t1": 25.19,
   "txt": "The patent explains"
  },
  {
   "t0": 25.19,
   "t1": 26.136,
   "txt": "the problem with"
  },
  {
   "t0": 26.136,
   "t1": 27.14,
   "txt": "an ordinary fork."
  },
  {
