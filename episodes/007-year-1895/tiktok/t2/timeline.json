   "t1": 16.824,
   "txt": "And it is"
  },
  {
   "t0": 16.824,
   "t1": 17.423,
   "txt": "not for one"
  },
  {
   "t0": 17.423,
   "t1": 18.296,
   "txt": "special machine."
  },
  {
   "t0": 18.576,
   "t1": 19.034,
   "txt": "It is a"
  },
  {
   "t0": 19.034,
   "t1": 20.016,
   "txt": "device of great"
  },
  {
   "t0": 20.016,
   "t1": 21.652,
   "txt": "simplicity and cheapness,"
  },
  {
   "t0": 21.652,
   "t1": 22.437,
   "txt": "which may be"
  },
  {
   "t0": 22.437,
   "t1": 23.354,
   "txt": "applied to any"
  },
