  {
   "t0": 4.935,
   "t1": 6.211,
   "txt": "on railroad tracks."
  },
  {
   "t0": 6.762,
   "t1": 7.368,
   "txt": "The goal,"
  },
  {
   "t0": 7.368,
   "t1": 8.377,
   "txt": "in the patent's"
  },
  {
   "t0": 8.377,
   "t1": 8.78,
   "txt": "words:"
  },
  {
