  },
  {
   "t0": 5.274,
   "t1": 5.673,
   "txt": "back."
  },
  {
   "t0": 6.224,
   "t1": 7.128,
   "txt": "The patent says"
  },
  {
   "t0": 7.128,
   "t1": 8.032,
   "txt": "animals as well"
  },
  {
   "t0": 8.032,
   "t1": 9.056,
