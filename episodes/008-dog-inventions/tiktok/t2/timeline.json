   "t1": 18.85,
   "txt": "a simple task"
  },
  {
   "t0": 18.85,
   "t1": 19.617,
   "txt": "to have the"
  },
  {
   "t0": 19.617,
   "t1": 20.592,
   "txt": "walker hold an"
  },
  {
   "t0": 20.592,
   "t1": 21.846,
   "txt": "umbrella both over"
  },
  {
   "t0": 21.846,
