   "t1": 4.329,
   "txt": "An opening."
  },
  {
   "t0": 4.729,
   "t1": 5.331,
   "txt": "And a bed,"
  },
  {
   "t0": 5.331,
   "t1": 6.113,
   "txt": "attached to a"
  },
  {
   "t0": 6.113,
   "t1": 6.414,
   "txt": "door."
  },
  {
   "t0": 6.965,
   "t1": 7.854,
   "txt": "It relates to"
  },
  {
   "t0": 7.854,
   "t1": 8.811,
   "txt": "beds which are"
  },
  {
   "t0": 8.811,
   "t1": 9.7,
   "txt": "adapted to be"
  },
  {
   "t0": 9.7,
   "t1": 10.52,
   "txt": "moved into a"
  },
  {
