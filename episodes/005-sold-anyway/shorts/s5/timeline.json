   "t1": 11.614,
   "txt": "closet or recess"
  },
  {
   "t0": 11.614,
   "t1": 12.366,
   "txt": "when not in"
  },
  {
   "t0": 12.366,
   "t1": 12.64,
   "txt": "use."
  },
  {
   "t0": 12.991,
   "t1": 13.712,
   "txt": "It's called a"
  },
  {
   "t0": 13.712,
   "t1": 14.655,
   "txt": "disappearing bed."
  },
  {
