  },
  {
   "t0": 21.394,
   "t1": 21.725,
   "txt": "room."
  },
  {
   "t0": 22.076,
   "t1": 22.807,
   "txt": "So that they"
  },
  {
   "t0": 22.807,
   "t1": 23.477,
